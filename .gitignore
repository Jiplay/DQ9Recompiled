# User-owned Nintendo DS images and ROM-derived outputs.
*.nds
/generated/
/extracted/
/.venv/
/build/
/build-*/
/saves/
/captures/
*.sav
*.log

# Runner performance logs (machine-specific).
performance-*.jsonl

__pycache__/

# scripts/build.py output.
/DQ9Recompiled
/DQ9Recompiled.exe
/*.zip
/*.tar.gz

# scripts/gen-lang.py output.
/src/hooks/lang.generated.h
# scripts/gen-map-names.py output (names from the ROM).
/src/hooks/map_names.generated.h
# scripts/build.py --package and scripts/package-mac.py output.
/pkg/
/pkg-dmg/
/*.app/

# Android build output, and the sideload signing key (a private key does not
# belong in git; see android/app/build.gradle.kts).
/android/.gradle/
/android/build/
/android/app/build/
/android/app/jniLibs/
/android/app/icon-res/
/android/local.properties
/android/keystore/
