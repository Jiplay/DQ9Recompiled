<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Netplay lobbies and the self-updater's release check and download -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The self-updater hands the downloaded APK to the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Discord's Social SDK (Rich Presence only, when the build has it) asks
         for these for its voice chat, which the game does not use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

    <!-- Touch drives the bottom screen, but a gamepad works without one -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="DQ9Recompiled"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:appCategory="game"
        android:isGame="true">

        <!-- DQ9RecompiledActivity extends SDL3's SDLActivity and names the native
             libraries to load (see getLibraries()). -->
        <activity
            android:name="com.birabittoh.dq9recompiled.DQ9RecompiledActivity"
            android:label="DQ9Recompiled"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tells SDL's Android glue which symbol is the entry point -->
            <meta-data android:name="SDL_MAIN_ENTRY_FUNCTION" android:value="SDL_main" />
        </activity>

        <!-- Serves the staged update APK to the package installer; the
             self-updater looks this authority up by name
             (ndsrecomp/runner/src/update/self_update_android.cpp). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The Social SDK's sign-in activity and voice call service: unused,
             Rich Presence needs no sign-in. -->
        <activity android:name="com.discord.socialsdk.AuthenticationActivity" tools:node="remove" />
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />

    </application>

</manifest>
